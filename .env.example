# ====================================================================
# Wedding QR Gallery - Configurare environment
# Copiaza acest fisier ca .env si completeaza valorile reale
# ====================================================================

# Portul pe care ruleaza aplicatia (pe cPanel acesta este setat automat)
PORT=3000

# URL public al aplicatiei (folosit pentru generarea QR code-ului si OAuth callback)
# IMPORTANT: cand faci deploy pe cPanel, schimba aceasta valoare cu URL-ul real
# Exemplu: https://nunta.exemplu.ro
PUBLIC_URL=http://localhost:3000

# Secret pentru sesiuni (genereaza unul random, lung)
# Poti folosi: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=schimba-acest-secret-cu-unul-random-foarte-lung

# ====================================================================
# Google OAuth (pentru acces la Drive-ul personal)
# ====================================================================
# 1. Mergi in Google Cloud Console → APIs & Services → Credentials
# 2. Configureaza OAuth consent screen (External, scope: .../auth/drive)
# 3. Adauga utilizatorul tau ca Test User (sau publica aplicatia)
# 4. Create Credentials → OAuth 2.0 Client ID → Web application
# 5. La "Authorized redirect URIs" adauga:
#    - http://localhost:3000/admin/drive/callback  (pentru development)
#    - https://nunta-ta.ro/admin/drive/callback     (pentru productie)
# 6. Copiaza Client ID si Client Secret aici
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ID-ul folderului Google Drive unde se salveaza pozele
# (se gaseste in URL-ul folderului: drive.google.com/drive/folders/ACEST_ID)
GOOGLE_DRIVE_FOLDER_ID=

# ====================================================================
# Admin
# ====================================================================
# Parola admin initiala (va fi hash-uita la primul start)
# Poti schimba parola din interfata admin dupa logare
# IMPORTANT: daca parola contine caractere speciale (#, $, !, etc.)
# pune-o INTRE GHILIMELE DUBLE, altfel dotenv interpreteaza # ca inceput de comentariu.
# Exemplu corect: ADMIN_INITIAL_PASSWORD="Parola11a#"
# Exemplu gresit: ADMIN_INITIAL_PASSWORD=Parola11a#   (va deveni doar "Parola11a")
ADMIN_INITIAL_PASSWORD="schimba-aceasta-parola"
