<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="hero">
  <div class="hero-inner">
    <p class="kicker">Bun venit</p>
    <h1 class="hero-title"><%= settings.brideName %> <span class="amp">&</span> <%= settings.groomName %></h1>
    <% if (settings.weddingDate) { %>
      <p class="hero-date"><%= settings.weddingDate %></p>
    <% } %>
    <p class="hero-text"><%= settings.welcomeMessage %></p>

    <div class="hero-actions">
      <a href="/upload" class="btn btn-primary">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        Adauga o poza
      </a>
      <a href="/gallery" class="btn btn-ghost">Vezi galeria</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
