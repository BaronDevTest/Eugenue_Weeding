<%- include('partials/head') %>
<%- include('partials/header') %>

<!-- Loader full-screen pana cand imaginea hero e gata.
     Folosim 'is-ready' pe body cand imaginea s-a incarcat (sau dupa timeout). -->
<div class="hero-loader" id="heroLoader" aria-hidden="true">
  <div class="hero-loader-inner">
    <div class="hero-loader-monogram">
      <span><%= settings.groomName.charAt(0) %></span>
      <span class="hero-loader-amp">&amp;</span>
      <span><%= settings.brideName.charAt(0) %></span>
    </div>
    <div class="hero-loader-spinner" aria-hidden="true"></div>
    <p class="hero-loader-text"><%= t('index.loading') %></p>
  </div>
</div>

<main class="hero">
  <div class="hero-inner">
    <p class="kicker"><%= t('index.kicker') %></p>

    <h1 class="hero-title">
      <span class="hero-name"><%= settings.groomName %></span>
      <span class="hero-amp">&amp;</span>
      <span class="hero-name"><%= settings.brideName %></span>
    </h1>

    <div class="hero-divider" aria-hidden="true">
      <span class="hero-divider-line"></span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>
      </svg>
      <span class="hero-divider-line"></span>
    </div>

    <% if (settings.weddingDate) { %>
      <p class="hero-date"><%= settings.weddingDate.replace(/[.\-\/]/g, ' · ') %></p>
    <% } %>

    <%
      var localizedMessage = settings['welcomeMessage' + locale.charAt(0).toUpperCase() + locale.slice(1)]
                          || settings.welcomeMessage
                          || t('index.welcomeMessage');
    %>
    <p class="hero-text"><%= localizedMessage %></p>

    <div class="hero-actions">
      <a href="/upload" class="btn btn-primary btn-hero">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        <%= t('index.btnUpload') %>
      </a>
      <a href="/gallery" class="hero-link">
        <%= t('index.btnGallery') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</main>

<script>
  (function () {
    // Preload imaginea principala. Cand e gata, scoatem loader-ul cu fade.
    var heroImg = '/static/images/main_image.jpg';
    var loader = document.getElementById('heroLoader');
    if (!loader) return;

    function dismissLoader() {
      if (loader.classList.contains('is-gone')) return;
      loader.classList.add('is-fade-out');
      // dupa animatie, scoatem din DOM (sau cel putin display: none)
      setTimeout(function () {
        loader.classList.add('is-gone');
      }, 600);
    }

    var img = new Image();
    img.onload = dismissLoader;
    img.onerror = dismissLoader; // chiar daca esueaza, nu blocam pagina
    img.src = heroImg;

    // Fallback safety: dupa 10s scoatem oricum loader-ul, ca sa nu blocheze nimic
    setTimeout(dismissLoader, 10000);

    // Daca DOMContentLoaded a fost deja (cache instant), imaginea poate fi deja in cache
    if (img.complete) dismissLoader();
  })();
</script>

<%- include('partials/footer') %>
