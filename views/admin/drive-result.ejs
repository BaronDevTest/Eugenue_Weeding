<%- include('../partials/head') %>
<%- include('layout-header') %>

<main class="admin-page">
  <div class="auth-card" style="margin: 40px auto; text-align: center;">
    <% if (ok) { %>
      <div style="color: #27ae60; margin-bottom: 16px;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <h1 style="margin-bottom: 8px;">Drive conectat</h1>
      <p class="muted"><%= message %></p>
    <% } else { %>
      <div style="color: #c0392b; margin-bottom: 16px;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
      </div>
      <h1 style="margin-bottom: 8px;">Eroare</h1>
      <p class="muted"><%= message %></p>
    <% } %>
    <div style="margin-top: 24px;">
      <a href="/admin" class="btn btn-primary">Inapoi la dashboard</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
