<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="page success-page">
  <div class="success-icon">
    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
  </div>
  <h1 class="page-title"><%= t('success.title') %></h1>
  <p class="page-subtitle">
    <% if (count === 1) { %>
      <%= t('success.subtitleOne') %>
    <% } else { %>
      <%= t('success.subtitleMany', { count: count }) %>
    <% } %>
  </p>
  <div class="hero-actions">
    <a href="/upload" class="btn btn-primary"><%= t('success.btnMore') %></a>
    <a href="/gallery" class="btn btn-ghost"><%= t('success.btnGallery') %></a>
  </div>
</main>

<%- include('partials/footer') %>
