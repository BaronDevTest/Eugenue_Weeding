<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="page success-page">
  <div class="success-icon">
    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
  </div>
  <h1 class="page-title">Multumim!</h1>
  <p class="page-subtitle">
    <% if (count === 1) { %>
      Poza ta a fost adaugata cu succes in albumul nuntii.
    <% } else { %>
      Cele <%= count %> fisiere au fost adaugate cu succes in albumul nuntii.
    <% } %>
  </p>
  <div class="hero-actions">
    <a href="/upload" class="btn btn-primary">Mai adaug o poza</a>
    <a href="/gallery" class="btn btn-ghost">Vezi galeria</a>
  </div>
</main>

<%- include('partials/footer') %>
