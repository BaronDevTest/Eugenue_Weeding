<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="page">
  <h1 class="page-title"><%= t('upload.title') %></h1>
  <p class="page-subtitle"><%= t('upload.subtitle') %></p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error" id="serverError"><%= error %></div>
  <% } %>

  <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
    <label class="dropzone" id="dropzone">
      <input type="file" name="photos" id="fileInput" accept="image/*" multiple />
      <div class="dropzone-content" id="dropzoneContent">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <p class="dropzone-title"><%= t('upload.dropTitle') %></p>
        <p class="dropzone-hint"><%= t('upload.dropHint', { max: settings.maxUploadMb }) %></p>
      </div>
    </label>

    <div class="preview-section" id="previewSection" hidden>
      <div class="dropzone-preview" id="preview"></div>
      <div class="preview-actions">
        <button type="button" class="btn btn-ghost btn-sm" id="addMoreBtn">+ <%= t('upload.addMore') %></button>
        <button type="button" class="btn-link" id="clearAllBtn"><%= t('upload.clearAll') %></button>
      </div>
    </div>

    <div class="form-row">
      <label for="guestName"><%= t('upload.guestNameLabel') %> <span class="optional"><%= t('upload.optional') %></span></label>
      <input type="text" id="guestName" name="guestName" maxlength="60" placeholder="<%= t('upload.guestNamePlaceholder') %>" />
    </div>

    <% if (settings.allowMessages) { %>
      <div class="form-row">
        <label for="message"><%= t('upload.messageLabel') %> <span class="optional"><%= t('upload.optional') %></span></label>
        <textarea id="message" name="message" rows="3" maxlength="280" placeholder="<%= t('upload.messagePlaceholder') %>"></textarea>
      </div>
    <% } %>

    <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
      <span class="btn-spinner" aria-hidden="true" hidden></span>
      <span class="btn-label"><%= t('upload.submit') %></span>
    </button>

    <!-- Mesaj informativ in timpul upload-ului. Text adaptat dupa tipul de fisiere. -->
    <div class="upload-info" id="uploadInfo" hidden aria-live="polite">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span id="uploadInfoText"></span>
    </div>
  </form>
</main>

<script>
  (function () {
    var input = document.getElementById('fileInput');
    var preview = document.getElementById('preview');
    var previewSection = document.getElementById('previewSection');
    var content = document.getElementById('dropzoneContent');
    var form = document.getElementById('uploadForm');
    var submitBtn = document.getElementById('submitBtn');
    var btnLabel = submitBtn.querySelector('.btn-label');
    var btnSpinner = submitBtn.querySelector('.btn-spinner');
    var btnLabelOriginal = btnLabel.textContent;
    var dropzone = document.getElementById('dropzone');
    var addMoreBtn = document.getElementById('addMoreBtn');
    var clearAllBtn = document.getElementById('clearAllBtn');

    // Acumulator de fisiere - dupa fiecare interactiune cu input-ul,
    // noile fisiere se ADAUGA, nu inlocuiesc selectia anterioara.
    var accumulated = [];

    function setInputFiles(files) {
      try {
        var dt = new DataTransfer();
        files.forEach(function (f) { dt.items.add(f); });
        input.files = dt.files;
      } catch (e) {
        // Fallback - majoritatea browserelor moderne suporta DataTransfer
      }
    }

    function fileKey(f) { return f.name + '_' + f.size + '_' + (f.lastModified || 0); }

    function addFiles(newFiles) {
      var existingKeys = {};
      accumulated.forEach(function (f) { existingKeys[fileKey(f)] = true; });
      Array.prototype.forEach.call(newFiles, function (f) {
        if (!existingKeys[fileKey(f)]) {
          accumulated.push(f);
          existingKeys[fileKey(f)] = true;
        }
      });
      setInputFiles(accumulated);
      renderPreviews();
    }

    function removeFile(index) {
      accumulated.splice(index, 1);
      setInputFiles(accumulated);
      renderPreviews();
    }

    function clearAll() {
      accumulated = [];
      setInputFiles(accumulated);
      input.value = '';
      renderPreviews();
    }

    var i18n = {
      uploading: <%- JSON.stringify(t('upload.uploading')) %>,
      compressing: <%- JSON.stringify(t('upload.compressing')) %>,
      errorGeneric: <%- JSON.stringify(t('upload.errorGeneric')) %>,
      filesSelected: <%- JSON.stringify(t('upload.filesSelected')) %>,
      filesSelectedPlural: <%- JSON.stringify(t('upload.filesSelectedPlural')) %>,
      tooLarge: <%- JSON.stringify(t('upload.errorTooLarge')) %>,
      noFiles: <%- JSON.stringify(t('upload.errorNoFiles')) %>,
      removeFile: <%- JSON.stringify(t('upload.removeFile')) %>,
      infoUploading: <%- JSON.stringify(t('upload.infoUploading')) %>,
      maxMb: <%= settings.maxUploadMb %>
    };

    // ============================================================
    // Compresie imagini client-side (Canvas API).
    // Reduce poza de la 3-5MB (telefon) la ~300-500KB pastrand calitate buna.
    // Skip pentru fisiere non-imagine (video) si pentru poze deja mici (<400KB).
    // Daca compresia esueaza din orice motiv (HEIC fara suport, OOM etc.),
    // se trimite originalul.
    // ============================================================
    var COMPRESS_MAX_DIM = 1920;   // px - dimensiunea max
    var COMPRESS_QUALITY = 0.85;   // JPEG quality 0-1
    var COMPRESS_SKIP_BELOW = 400 * 1024; // sub 400KB nu mai are sens

    function compressImage(file) {
      return new Promise(function (resolve) {
        if (!file.type || !file.type.startsWith('image/') || file.size < COMPRESS_SKIP_BELOW) {
          return resolve(file); // skip - returneaza originalul
        }
        var img = new Image();
        var url = URL.createObjectURL(file);
        var done = false;
        var fallback = function () { if (!done) { done = true; URL.revokeObjectURL(url); resolve(file); } };
        img.onerror = fallback;
        img.onload = function () {
          try {
            var w = img.naturalWidth, h = img.naturalHeight;
            if (w > COMPRESS_MAX_DIM || h > COMPRESS_MAX_DIM) {
              if (w >= h) { h = Math.round(h * COMPRESS_MAX_DIM / w); w = COMPRESS_MAX_DIM; }
              else        { w = Math.round(w * COMPRESS_MAX_DIM / h); h = COMPRESS_MAX_DIM; }
            }
            var canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            canvas.toBlob(function (blob) {
              URL.revokeObjectURL(url);
              if (!blob || blob.size >= file.size) {
                // Compresia nu a ajutat - folosim originalul
                done = true; return resolve(file);
              }
              // Nume cu extensie jpg ca sa fie clar pe Drive
              var newName = file.name.replace(/\.[^./\\]+$/, '') + '.jpg';
              var compressed = new File([blob], newName, { type: 'image/jpeg', lastModified: Date.now() });
              done = true; resolve(compressed);
            }, 'image/jpeg', COMPRESS_QUALITY);
          } catch (e) {
            fallback();
          }
        };
        img.src = url;
        // safety timeout - daca dureaza mult, abandonam si trimitem originalul
        setTimeout(fallback, 30000);
      });
    }

    async function compressAll(files, onProgress) {
      var out = [];
      for (var i = 0; i < files.length; i++) {
        if (onProgress) onProgress(i, files.length);
        var c = await compressImage(files[i]);
        out.push(c);
      }
      if (onProgress) onProgress(files.length, files.length);
      return out;
    }

    function renderPreviews() {
      preview.innerHTML = '';
      if (accumulated.length === 0) {
        previewSection.hidden = true;
        content.hidden = false;
        dropzone.hidden = false;
        return;
      }
      // Cand sunt poze selectate, ascundem complet dropzone-ul si folosim doar "Add more"
      content.hidden = true;
      previewSection.hidden = false;
      dropzone.hidden = true;

      accumulated.forEach(function (file, index) {
        var item = document.createElement('div');
        item.className = 'preview-item';

        var img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.onload = function () { URL.revokeObjectURL(img.src); };
        item.appendChild(img);

        // Buton X pentru a elimina fisierul
        var rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className = 'preview-remove';
        rmBtn.setAttribute('aria-label', i18n.removeFile);
        rmBtn.innerHTML = '&times;';
        rmBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          removeFile(index);
        });
        item.appendChild(rmBtn);

        preview.appendChild(item);
      });

      var count = document.createElement('p');
      count.className = 'preview-count';
      var key = accumulated.length === 1 ? i18n.filesSelected : i18n.filesSelectedPlural;
      count.textContent = key.replace('{{count}}', accumulated.length);
      preview.appendChild(count);
    }

    input.addEventListener('change', function () {
      addFiles(input.files);
    });

    addMoreBtn.addEventListener('click', function (e) {
      e.preventDefault();
      input.value = '';
      input.click();
    });
    clearAllBtn.addEventListener('click', function (e) {
      e.preventDefault();
      clearAll();
    });

    ['dragenter', 'dragover'].forEach(function (ev) {
      dropzone.addEventListener(ev, function (e) { e.preventDefault(); dropzone.classList.add('is-drag'); });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
      dropzone.addEventListener(ev, function (e) { e.preventDefault(); dropzone.classList.remove('is-drag'); });
    });
    dropzone.addEventListener('drop', function (e) {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
        addFiles(e.dataTransfer.files);
      }
    });

    function setButtonLoading(loading, text) {
      submitBtn.disabled = loading;
      btnSpinner.hidden = !loading;
      if (loading) {
        btnLabel.textContent = text || i18n.uploading;
      } else {
        btnLabel.textContent = btnLabelOriginal;
      }
    }
    var uploadInfo = document.getElementById('uploadInfo');
    var uploadInfoText = document.getElementById('uploadInfoText');

    function showUploadInfo(text) {
      if (uploadInfoText) uploadInfoText.textContent = text;
      if (uploadInfo) uploadInfo.hidden = false;
    }
    function hideUploadInfo() {
      if (uploadInfo) uploadInfo.hidden = true;
    }
    function setPercent(/* unused - we don't show percentage */) {}

    function showError(msg) {
      var existing = document.getElementById('serverError');
      if (existing) existing.remove();
      var el = document.createElement('div');
      el.id = 'serverError';
      el.className = 'alert alert-error';
      el.textContent = msg;
      form.parentNode.insertBefore(el, form);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      if (accumulated.length === 0) {
        showError(i18n.noFiles);
        return;
      }
      var maxBytes = i18n.maxMb * 1024 * 1024;
      for (var i = 0; i < accumulated.length; i++) {
        var f = accumulated[i];
        if (f.size > maxBytes) {
          showError(i18n.tooLarge.replace('{{name}}', f.name).replace('{{max}}', i18n.maxMb));
          return;
        }
      }

      // PAS 1: comprimam toate imaginile inainte de upload (client-side).
      setButtonLoading(true, i18n.compressing);
      var compressed;
      try {
        compressed = await compressAll(accumulated, function (done, total) {
          btnLabel.textContent = i18n.compressing + ' ' + done + '/' + total;
        });
      } catch (err) {
        setButtonLoading(false);
        showError(i18n.errorGeneric + ' (compress: ' + err.message + ')');
        return;
      }

      // PAS 2: construim FormData cu fisierele comprimate.
      var fd = new FormData();
      compressed.forEach(function (f) { fd.append('photos', f, f.name); });
      var guest = document.getElementById('guestName');
      if (guest && guest.value) fd.append('guestName', guest.value);
      var msg = document.getElementById('message');
      if (msg && msg.value) fd.append('message', msg.value);

      // Trecem in faza "uploading" pe buton + afisam mesajul informativ.
      btnLabel.textContent = i18n.uploading;
      showUploadInfo(i18n.infoUploading);
      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/upload', true);
      xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
      xhr.setRequestHeader('Accept', 'application/json');

      xhr.upload.onprogress = function (evt) {
        if (evt.lengthComputable) {
          setPercent((evt.loaded / evt.total) * 100);
        }
      };
      xhr.onload = function () {
        var data = null;
        try { data = JSON.parse(xhr.responseText); } catch (e) {}

        if (xhr.status >= 200 && xhr.status < 300 && data && data.ok) {
          window.location.href = data.redirectTo || '/gallery';
        } else {
          setButtonLoading(false);
          hideUploadInfo();
          var msg = (data && data.error) ? data.error : (i18n.errorGeneric + ' (HTTP ' + xhr.status + ')');
          showError(msg);
        }
      };
      xhr.onerror = function () {
        setButtonLoading(false);
        hideUploadInfo();
        showError(i18n.errorGeneric);
      };

      setButtonLoading(true);
      xhr.send(fd);
    });
  })();
</script>

<%- include('partials/footer') %>
